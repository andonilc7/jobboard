# Public (exposed to the browser; access is enforced by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: used by `pnpm db:seed`. Never prefix with VITE_, never set in Vercel.
# Preferred alternative to the legacy key below:
# SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (`pnpm db:types`, `pnpm supabase db push`)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_DB_PASSWORD=your-database-password
